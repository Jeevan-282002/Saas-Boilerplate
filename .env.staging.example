# Staging Deployment Environment Configuration Template
# Generate all secrets securely. Never commit populated .env files to version control.

# Core Security
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-cryptographically-random-characters
DJANGO_ALLOWED_HOSTS=api.staging.example.com,staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.staging.example.com,https://staging.example.com

# Multi-Tenancy & Database Routing
DJANGO_ALLOW_DEFAULT_TENANT=false
TENANT_DOMAIN_SUFFIX=staging.example.com
DJANGO_DEFAULT_TENANT_ALIAS=default

# Central Application Database (PostgreSQL 17)
DATABASE_URL=postgresql://app_user:SECURE_PASSWORD@db-host:5432/app_staging

# Tenant Provisioning Role (Requires CREATEDB and ownership of tenant databases)
TENANT_DATABASE_ADMIN_URL=postgresql://provisioning_admin:SECURE_PASSWORD@db-host:5432/postgres

# Redis (Celery Broker & Distributed Cache / Rate Limiting)
REDIS_URL=redis://redis-host:6379/0
DJANGO_CACHE_URL=redis://redis-host:6379/1

# HTTPS, HSTS, and Trusted Ingress (Enable ONLY after HTTPS is verified on ingress)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_X_FORWARDED_PROTO=true

# Observability
DJANGO_LOG_LEVEL=INFO

